# 서버 설정 예시. 복사해서 .env로 쓰고 값을 채움 (.env는 git에 안 올라감)
#   cp .env.example .env

# 로그인 토큰 서명 키. 비워 두면 서버를 켤 때마다 바뀜 (그러면 앱이 다시 로그인해야 함)
#   만들기: python3 -c "import secrets; print(secrets.token_hex(32))"
MTM_JWT_SECRET=

# 카카오 로그인: 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 화면의 앱 ID (숫자). 받은 토큰이 우리 앱 것인지 확인할 때 씀
MTM_KAKAO_APP_ID=

# 구글 로그인: Google Cloud 콘솔의 OAuth 클라이언트 id (안드로이드 앱이 ID token을 받을 때 쓰는 웹 클라이언트 id). 쉼표로 여러 개
MTM_GOOGLE_CLIENT_IDS=

# 개발용 로그인 (카카오·구글 SDK 없이 POST /api/auth/dev {"token": "아무 이름"}). 서비스에서는 0
MTM_DEV_LOGIN=1

# 사건 폴더, 영상 크기 제한(MB), 저장 안 한 사건 보관 기간(일), 신고 몇 번이면 숨길지
MTM_CASES_DIR=data/cases
MTM_MAX_UPLOAD_MB=200
MTM_KEEP_DAYS=7
MTM_HIDE_REPORTS=3
